# Copy this file to .env.local only when local automation needs it.
# Never commit .env.local or real API keys.

# Public GitHub Pages PWA does not need runtime secrets.

# Apps in Toss deploy helper.
# Preferred long-lived setup: run `npm run ait:token:add` once and keep the token
# in the local Apps in Toss CLI profile store, not in this repository.
APPS_IN_TOSS_PROFILE=default

# Temporary one-off setup only. If set, `npm run ait:token:add` registers this
# key into the local CLI profile. Delete it from .env.local after registration.
APPS_IN_TOSS_API_KEY=

# Default candidate artifact path for deploy helper.
APPS_IN_TOSS_AIT_LOCATION=apps-in-toss/baby-gift-tax-helper.ait

# Optional deploy memo. Keep this non-sensitive.
APPS_IN_TOSS_DEPLOY_MEMO=
